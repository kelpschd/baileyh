# ---------------------------------------------------------------------------
# Pipeline outputs — regenerated by every run, do NOT commit
# ---------------------------------------------------------------------------
# Adjust these to match your actual --out-dir names.
seg_out/
out/
output/
results/
cell_pngs/
parts/

# Generated CSVs (cells_all, lys/prab objects, failures, per-task parts)
cells_all.csv
lys_objects_all.csv
prab_objects_all.csv
failures*.csv
*.part*.csv

# Generated PNGs (per-cell crops, overlays, masks)
*.png

# ---------------------------------------------------------------------------
# Cellpose model weights — large binaries, keep out of git
# ---------------------------------------------------------------------------
# You point CELLPOSE_LOCAL_MODELS_PATH at /data/kelpschdj/cellpose/models on
# Biowulf, so weights live outside the repo anyway — but ignore any local copy.
models/
cellpose/
*.pth
*.pt

# ---------------------------------------------------------------------------
# Slurm / HPC job artifacts
# ---------------------------------------------------------------------------
logs/
*.out
*.err
slurm-*.out
slurm-*.err

# ---------------------------------------------------------------------------
# Config / secrets (if you add machine-specific config later)
# ---------------------------------------------------------------------------
*.local.yaml
*.local.yml
.env